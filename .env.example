# Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Required for the local web API. Only this Google account may access protected routes.
GOOGLE_ALLOWED_EMAIL="you@example.com"

# Optional: Additional comma-separated HTTPS gateway hosts. The built-in allowlist
# already includes gateway.pcg.io and generativelanguage.googleapis.com.
# AI_ALLOWED_BASE_URLS="ai.example.com"

# ---------------------------------------------------------------------------
# CLI-Modus (npm run agent -- ...) – Google Zugriff ohne Browser-Login.
# Der Refresh-Token wird von "npm run agent -- auth" automatisch in diese
# Datei geschrieben. Danach läuft alles headless (auch als Cron-Job).
# ---------------------------------------------------------------------------

# Wird von 'auth' automatisch gespeichert. NICHT manuell anlegen.
# GOOGLE_REFRESH_TOKEN="..."

# Eigener OAuth-Desktop-Client aus der Google Cloud Console.
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# Optional: Port für den einmaligen Auth-Redirect (Standard 4315)
# GOOGLE_REDIRECT_PORT="4315"

# Optional: Google Chat Raum-ID für den Bot-Rückkanal (z. B. spaces/XXXX).
# Ermitteln mit: npm run agent -- chat-spaces
# CHAT_SPACE_ID="spaces/XXXX"

